{
  "name": "virunx-source",
  "version": "0.5.0",
  "private": true,
  "description": "sources of the npm package virunx: the CLI and its libraries",
  "license": "GPL-3.0-only",
  "author": "Vishota",
  "homepage": "https://run.vishota.com",
  "workspaces": [
    "packages/proto",
    "packages/core",
    "packages/cli"
  ],
  "scripts": {
    "build": "npm run build -w @virun/proto -w @virun/core -w virunx",
    "clean": "node -e \"const fs=require('node:fs');for (const p of ['proto','core','cli']) fs.rmSync('packages/'+p+'/dist',{recursive:true,force:true})\""
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/ws": "^8.5.0",
    "node-datachannel": "^0.33.6",
    "typescript": "^5.5.0"
  }
}
