{
  "name": "virunx",
  "version": "0.5.0",
  "description": "expose a local port behind a public link (virun tunnel CLI)",
  "license": "GPL-3.0-only",
  "author": "Vishota",
  "homepage": "https://run.vishota.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/Vishota/virunx.git"
  },
  "bin": {
    "virunx": "dist/index.js"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node ../../scripts/copy-license.cjs && esbuild src/index.ts --bundle --platform=node --format=cjs --external:ws --banner:js=\"#!/usr/bin/env node\" --outfile=dist/index.js"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "optionalDependencies": {
    "node-datachannel": "^0.33.6"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  }
}
